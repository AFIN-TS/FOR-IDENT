# Environment file of the for-ident service: /etc/for-ident/for-ident.env
# Owner root:forident, mode 640. Never commit the filled-in file.
#
# Only the passwords are required for the profiles lc; URLs and user names default to
# jdbc:postgresql://localhost:5432/fi-lc-<database> and forident (see application-lc.properties).

FI_DB_USER_PASSWORD=
FI_DB_STOFFIDENT_PASSWORD=
FI_DB_PLANTIDENT_PASSWORD=

# Optional, only when different from the defaults:
# FI_DB_USER_URL=jdbc:postgresql://localhost:5432/fi-lc-users
# FI_DB_USER_USERNAME=forident

# Mail for registration, account activation and password reset (topic T5). Empty host = no mails are sent.
# SMTP of an existing mailbox of the domain (SP-16): port 587 with STARTTLS (FI_MAIL_STARTTLS=true) or port 465
# with SSL (FI_MAIL_SSL=true); the sender address must belong to that mailbox. Check with "Send test mail" in the
# user administration.
# FI_MAIL_HOST=
# FI_MAIL_PORT=587
# FI_MAIL_SMTP_AUTH=true
# FI_MAIL_STARTTLS=true
# FI_MAIL_SSL=false
# FI_MAIL_USERNAME=
# FI_MAIL_PASSWORD=
# FI_FROM_EMAIL_ADDRESS=
# Addresses that get the registration and report mails (comma separated)
# FI_CONTACT_ADDRESSES=

# Session: uploaded files are deleted when the session ends (logout, or this timeout after the
# browser window was closed)
# FI_SESSION_TIMEOUT=5m
# FI_SESSION_TEMP_DIRECTORY=

# Transformation products (MongoDB), off by default. When off, no MongoDB is needed (since 3.0).
# FI_PATHWAY_ENABLED=false
