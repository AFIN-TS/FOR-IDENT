<#-- HTML output format (.ftlh): every ${...} is escaped, text entered by the visitor stays plain text (SP-20, S2) -->
<!DOCTYPE html>
<html lang="en">
<body>
<p>This is an autogenerated message.</p>
<#if report.mailTo?has_content>
<p><a href="${report.mailTo}">Click here to reply</a></p>
</#if>
<p><span>Report Date: ${report.date!}</span></p>
<p><span>Submitted by (Username): ${report.username!}</span></p>
<p><span>Organisation: ${report.organisation!}</span></p>
<p><span>Contact E-Mail: ${report.email!}</span></p>
<p><span>Reported Entries:</span></p>

<table style="border-collapse:collapse;">
  <tr>
    <th style="border: 1px solid black">Public ID</th>
    <th style="border: 1px solid black">Name</th>
    <th style="border: 1px solid black">SMILES</th>
    <th style="border: 1px solid black">InChi</th>
    <th style="border: 1px solid black">InChi Key</th>
  </tr>
<#list report.entries![] as entry>
  <tr>
    <td style="border: 1px solid black">${entry.publicID!}</td>
    <td style="border: 1px solid black">${(entry.name.value)!}</td>
    <td style="border: 1px solid black">${(entry.smiles.value)!}</td>
    <td style="border: 1px solid black">${(entry.inchi.value)!}</td>
    <td style="border: 1px solid black">${(entry.inchiKey.value)!}</td>
  </tr>
</#list>
</table>

<p><span>Comment:</span></p>
<p style="white-space: pre-wrap;">${report.comment!}</p>
</body>
</html>
