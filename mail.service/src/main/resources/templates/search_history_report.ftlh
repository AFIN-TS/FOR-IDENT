<#-- HTML output format (.ftlh): every ${...} is escaped (SP-20, S2). Parameter block rewritten (SP-20, R10): only
     properties of SearchParameter, every one optional. -->
<#assign sp = report.searchParameter>
<!DOCTYPE html>
<html lang="en">
<body>
<p>This is an autogenerated message.</p>
<#if report.mailTo?has_content>
<p><a href="${report.mailTo}">Click here to reply</a></p>
</#if>
<p><span>Report Date: ${report.date!}</span></p>
<p><span>Submitted by (Username): ${report.username!}</span></p>
<p><span>Organisation: ${report.organisation!}</span></p>
<p><span>Contact E-Mail: ${report.email!}</span></p>
<p><span>Selected Source lists:</span></p>
<ul>
<#list report.sourceLists![] as sourceList>
  <li>${sourceList.name!}</li>
</#list>
</ul>
<p><span>Search Parameter:</span></p>
<ul>
<#if sp.cas?has_content><li>CAS: ${sp.cas}</li></#if>
<#if sp.name?has_content><li>Name: ${sp.name}</li></#if>
<#if sp.elementalFormula?has_content><li>Formula: ${sp.elementalFormula}</li></#if>
<#if sp.iupac?has_content><li>IUPAC: ${sp.iupac}</li></#if>
<#if sp.smiles?has_content><li>SMILES: ${sp.smiles}</li></#if>
<#if sp.accurateMass??><li>Accurate Mass: ${sp.accurateMass?c}</li></#if>
<#if sp.ppm?? && sp.ppm != 0><li>PPM: ${sp.ppm?c}</li></#if>
<#if sp.ionisation??><li>Ionisation: ${sp.ionisation}</li></#if>
<#if sp.logP??><li>LogP: ${sp.logP?c}<#if sp.logPDelta?? && sp.logPDelta != 0> ± ${sp.logPDelta?c}</#if></li></#if>
<#if sp.logD??><li>LogD: ${sp.logD?c}<#if sp.logDDelta?? && sp.logDDelta != 0> ± ${sp.logDDelta?c}</#if></li></#if>
<#if sp.halogens?has_content><li>Halogens: ${sp.halogens?join(", ")}</li></#if>
<#if (sp.indexChar!"")?trim?has_content><li>Index: ${sp.indexChar}</li></#if>
<#if sp.publicID?has_content><li>Public ID: ${sp.publicID}</li></#if>
<#if sp.inchiKey?has_content><li>InChI Key: ${sp.inchiKey}</li></#if>
<#if sp.datasourceNames?has_content>
<li>Databases:
  <ul>
  <#list sp.datasourceNames as datasourceName>
    <li>${datasourceName}</li>
  </#list>
  </ul>
</li>
</#if>
</ul>

<p><span>Comment:</span></p>
<p style="white-space: pre-wrap;">${report.comment!}</p>
</body>
</html>
