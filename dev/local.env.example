# Local development secrets for FOR-IDENT.
# Copy to dev/local.env (ignored by Git) or keep it outside the repository
# and pass it with -SecretsFile. Never commit real values.

# Password of the PostgreSQL superuser "postgres" (set when installing PostgreSQL)
PG_SUPERUSER_PASSWORD=

# Password of the application database role "forident" (created by setup-local-db.ps1)
FI_DB_APP_PASSWORD=

# Initial password of the user "admin" (used by run-local.ps1 -Init)
FI_ADMIN_PASSWORD=

# NVD API key for the CVE scan (dev/run-cve-scan.ps1), free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
